@model ML.Usuario


@{
    ViewData["Title"] = "GetAll";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Usuarios</h1>

<div class="container">

    <div class="row">
        <div class="col-6">
            <button id="btnBusqueda" class="btn btn-secondary w-100">Busqueda</button>

        </div>
        <div class="col-6">
            <button type="button" class="btn btn-primary w-100">Carga Masiva</button>
        </div>
    </div>


    @using (Html.BeginForm("GetAll", "Usuario", FormMethod.Post))
    {
        <div class="row">
            <div class=" col-md-12">
                <div class="card mt-2" id="busquedaForm" style="display: none;">
                    <h5 class="card-header">Busqueda</h5>
                    <div class="card-body">

                        <div class="row">
                            <div class="col-md-3 mt-2">
                                @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control", placeholder = "Nombre", @id = "txtNombre" })
                            </div>
                            <div class="col-md-3 mt-2">
                                @Html.TextBoxFor(model => model.ApellidoPaterno, new { @class = "form-control", placeholder = "Apellido Paterno", @id = "txtApellidoPaterno" })
                            </div>
                            <div class="col-md-3 mt-2">
                                @Html.TextBoxFor(model => model.ApellidoMaterno, new { @class = "form-control", placeholder = "Apellido Materno", @id = "txtApellidoMaterno" })
                            </div>
                            <div class="col-md-3 mt-2">
                                @Html.DropDownListFor(model => model.Rol.IdRol, new SelectList(Model.Rol.Rols, "IdRol", "Nombre"), "Seleccione un Rol", new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="col-md-6 mt-2 offset-md-5">
                            <button type="submit" class="btn btn-outline-success">Buscar</button>

                            <button type="reset" id="btnCancelar" class="btn btn-outline-danger">Cancelar</button>

                        </div>


                    </div>
                </div>

            </div>

            <div class=" col-md-12 mt-2">
                @Html.ActionLink("Agregar Usuario", "Form", "Usuario", new { IdUsuario = 0 }, new { @class = "btn btn-success" })
            </div>

        </div>

    }


    @* Seccion tabla Usuario *@
    <div class="row mt-2">

        <div class="col-md-12 table-responsive">

            @if (Model.Usuarios != null)
            {
                <table class="table table-hover text-center">
                    <thead>
                        <tr>
                            <th>Acciones</th>
                            <th>Id Usuario</th>
                            <th>Rol</th>
                            <th>Username</th>
                            <th>Nombre</th>
                            <th>Apellido Paterno</th>
                            <th>Apellido Materno</th>
                            <th>Email</th>
                            <th>Password</th>
                            <th>Sexo</th>
                            <th>Telefono</th>
                            <th>Celular</th>
                            <th>Fecha Nacimiento</th>
                            <th>CURP</th>
                            
                            

                        </tr>
                    </thead>

                    <tbody>
                        @foreach (ML.Usuario usuario in Model.Usuarios)
                        {
                            <tr>
                                <td>
                                    <a class="btn btn-warning" href="@Url.Action("Form", "Usuario", new { IdUsuario = usuario.IdUsuario })">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pen-fill" viewBox="0 0 16 16">
                                            <path d="m13.498.795.149-.149a1.207 1.207 0 1 1 1.707 1.708l-.149.148a1.5 1.5 0 0 1-.059 2.059L4.854 14.854a.5.5 0 0 1-.233.131l-4 1a.5.5 0 0 1-.606-.606l1-4a.5.5 0 0 1 .131-.232l9.642-9.642a.5.5 0 0 0-.642.056L6.854 4.854a.5.5 0 1 1-.708-.708L9.44.854A1.5 1.5 0 0 1 11.5.796a1.5 1.5 0 0 1 1.998-.001" />
                                        </svg>
                                    </a>
                                    <button type="button" class="btn btn-danger mt-2" data-bs-toggle="modal" data-bs-target="#exampleModal" onclick="UsuarioDelete(@usuario.IdUsuario, '@usuario.Nombre')">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash2-fill" viewBox="0 0 16 16">
                                            <path d="M2.037 3.225A.7.7 0 0 1 2 3c0-1.105 2.686-2 6-2s6 .895 6 2a.7.7 0 0 1-.037.225l-1.684 10.104A2 2 0 0 1 10.305 15H5.694a2 2 0 0 1-1.973-1.671zm9.89-.69C10.966 2.214 9.578 2 8 2c-1.58 0-2.968.215-3.926.534-.477.16-.795.327-.975.466.18.14.498.307.975.466C5.032 3.786 6.42 4 8 4s2.967-.215 3.926-.534c.477-.16.795-.327.975-.466-.18-.14-.498-.307-.975-.466z" />
                                        </svg>
                                    </button>
                                </td>

                                <td>@usuario.IdUsuario</td>
                                <td>@usuario.Rol.Nombre</td>
                                <td>@usuario.UserName</td>
                                <td>@usuario.Nombre</td>
                                <td>@usuario.ApellidoPaterno</td>
                                <td>@usuario.ApellidoMaterno</td>
                                <td>@usuario.Email</td>
                                <td>@usuario.Password</td>
                                <td>@usuario.Sexo</td>
                                <td>@usuario.Telefono</td>
                                <td>@usuario.Celular</td>
                                <td>@usuario.FechaNacimiento</td>
                                <td>@usuario.Curp</td>
                                


                                
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-danger">
                    No existen registros para la tabla Usuario. Error: @ViewBag.Mensaje
                </div>
            }

        </div>
    </div>
</div>


<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Eliminar Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Estas seguro que deseas eliminar al Usuario: <span id="NombreUsuario"></span>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <a id="btnEliminarUsuario" href="" class="btn btn-danger">Eliminar</a>
            </div>
        </div>
    </div>
</div>

@* @Scripts.Render("~/bundles/jquery") *@
<script src="~/lib/jquery/dist/jquery.js"></script>  @* Cualquier linea de estas manda a llamar a JS *@

<script>
    function UsuarioDelete(IdUsuario, NombreUsuario) {
        $('#NombreUsuario').text(NombreUsuario)
        $('#btnEliminarUsuario').attr('href','@Url.Action("Delete", "Usuario")' + '?IdUsuario=' + IdUsuario)
    }

    $(document).ready(function(){
        $('#btnBusqueda').click(function(){
            $('#busquedaForm').slideToggle();
        });

        $('#btnCancelar').click(function(){
            $('#busquedaForm').slideUp();
        });

    });

</script>






