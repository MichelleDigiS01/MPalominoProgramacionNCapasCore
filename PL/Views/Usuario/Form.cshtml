@model ML.Usuario
@{
    ViewData["Title"] = "Form";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/css/jquery-ui.css" rel="stylesheet" />

<div class="container">

    @if (Model.IdUsuario > 0)
    {
        <h1>Formulario Actualizar</h1>
    }
    else
    {
        <h1>Formulario Agregar</h1>
    }


        @using (Html.BeginForm("Form", "Usuario", FormMethod.Post, new { @enctype = "multipart/form-data", @id = "form" }))
    {

        
            <div class="row">
                @*Parte del Datos Usuario*@
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header text-center">
                            Datos Usuario
                        </div>
                        <div class="card-body">

                            @Html.HiddenFor(model => model.IdUsuario)

                            <div class="row">
                                <div class="col-md-6 mt-2">

                                    @Html.LabelFor(model => model.UserName)
                                    @Html.TextBoxFor(model => model.UserName, new { @class = "form-control", onblur = "return sinEspaciosThis(this)", onkeypress = "return sinEspaciosEvent(this, event)", @id = "txtUserName" })
                                    <span></span>
                                    @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger " })
                                </div>
                                <div class="col-md-6 mt-2">
                                    @Html.LabelFor(model => model.Password)
                                    @Html.TextBoxFor(model => model.Password, new { @class = "form-control", onblur = "return validarPasswordThis(this)", onkeypress = "return validarPasswordEvent(this, event)", @id = "txtPassword" })
                                    <span></span>
                                    @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger " })
                                </div>

                            </div>

                            <div class="row">
                                <div class="col-md-4 mt-2">
                                    @Html.LabelFor(model => model.Nombre, new { @id = "lblNombre" })
                                    @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control", onblur = "return soloLetrasThis(this)", onkeypress = "return soloLetrasEvent(this, event)", @id = "txtNombre" })
                                    <span></span>
                                    @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger " })
                                </div>
                                <div class="col-md-4 mt-2">

                                    @Html.LabelFor(model => model.ApellidoPaterno, "Apellido Paterno")
                                    @Html.TextBoxFor(model => model.ApellidoPaterno, new { @class = "form-control", onblur = "return soloLetrasThis(this)", onkeypress = "return soloLetrasEvent(this, event)", @id = "txtApellidoPaterno" })
                                    <span></span>
                                    @Html.ValidationMessageFor(model => model.ApellidoPaterno, "", new { @class = "text-danger " })
                                </div>

                                <div class="col-md-4 mt-2">
                                    @Html.LabelFor(model => model.ApellidoMaterno, "Apellido Materno")
                                    @Html.TextBoxFor(model => model.ApellidoMaterno, new { @class = "form-control", onblur = "return soloLetrasThis(this)", onkeypress = "return soloLetrasEvent(this, event)", @id = "txtApellidoMaterno" })
                                    <span></span>
                                    @Html.ValidationMessageFor(model => model.ApellidoMaterno, "", new { @class = "text-danger " })
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mt-2">

                                    @Html.LabelFor(model => model.Email)
                                    @Html.TextBoxFor(model => model.Email, new { @class = "form-control", onblur = "return validarCorreo(this)", @id = "txtEmail" })
                                    <span></span>
                                    @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger " })
                                </div>
                                <div class="col-md-6 mt-2">
                                    <label class="form-label d-block">Sexo</label>
                                    <div class="form-check form-check-inline">
                                        @Html.RadioButtonFor(model => model.Sexo, "M ", new { @class = "form-check-input", id = "sexoM" })
                                        <label class="form-check-label" for="sexoM">Masculino</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        @Html.RadioButtonFor(model => model.Sexo, "F ", new { @class = "form-check-input", id = "sexoF" })
                                        <label class="form-check-label" for="sexoF">Femenino</label>
                                    </div>
                                    <span></span>
                                    @Html.ValidationMessageFor(model => model.Sexo, "", new { @class = "text-danger " })
                                </div>
                            </div>


                            <div class="row">

                                <div class="col-md-6 mt-2">
                                    @Html.LabelFor(model => model.Telefono)
                                    @Html.TextBoxFor(model => model.Telefono, new { @class = "form-control", onblur = "return soloNumerosThis(this)", onkeypress = "return soloNumerosEvent(this, event)", @id = "txtTelefono" })
                                    <span></span>
                                    @Html.ValidationMessageFor(model => model.Telefono, "", new { @class = "text-danger " })
                                </div>

                                <div class="col-md-6 mt-2">

                                    @Html.LabelFor(model => model.Celular)
                                    @Html.TextBoxFor(model => model.Celular, new { @class = "form-control", onblur = "return soloNumerosThis(this)", onkeypress = "return soloNumerosEvent(this, event)", @id = "txtCelular" })
                                    <span></span>
                                    @Html.ValidationMessageFor(model => model.Celular, "", new { @class = "text-danger " })
                                </div>


                            </div>
                            <div class="row">

                                <div class="col-md-4 mt-2">

                                    @Html.LabelFor(model => model.FechaNacimiento, "Fecha de Nacimiento")

                                    @Html.TextBoxFor(model => model.FechaNacimiento,  new { @class = "form-control", type = "text", @id = "txtFechaNacimiento", onblur= "return validarFecha(this, event)"})
                                    <span></span>
                                    @Html.ValidationMessageFor(model => model.FechaNacimiento, "", new { @class = "text-danger " })
                                </div>
                                <div class="col-md-4 mt-2">

                                    @Html.LabelFor(model => model.Curp)
                                    @Html.TextBoxFor(model => model.Curp, new { @class = "form-control", onblur = "return validarCURP(this, event)", @id = "txtCURP" })
                                    <span></span>
                                @Html.ValidationMessageFor(model => model.Curp, "", new { @class = "text-danger " })
                                </div>
                                <div class="col-md-4 mt-2">
                                    @Html.LabelFor(model => model.Rol.IdRol, "Rol")
                                    @Html.DropDownListFor(model => model.Rol.IdRol, new SelectList(Model.Rol.Rols, "IdRol", "Nombre"), "Seleccione un Rol", new { @class = "form-control", @id = "ddlRol", onchange = " return validarRol(this)" })
                                    <span></span>
                                    @Html.ValidationMessageFor(model => model.Rol.IdRol, "", new { @class = "text-danger " })
                                </div>
                            </div>


                        </div>

                    </div>
                </div>

                <div class="row">

                    <div class="row">
                        <div class="col-md-6 mt-3">

                            <button type="submit" value="GuardarUsuario" name="Action" class="btn btn-success pl">Guardar</button>

                            @Html.ActionLink("Regresar", "GetAll", "Usuario", new { IdUsuario = 0 }, new { @class = "btn btn-danger" })
                        </div>
                    </div>
                </div>
            </div>
       
    }
</div>



<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/lib/jquery/dist/jquery-ui.js"></script>


<script>
    DatePicker();
    function DatePicker(){
        $("#txtFechaNacimiento").datepicker();
            $("#txtFechaNacimiento").datepicker({
               dateFormat: 'dd-mm-yy',
               changeMonth: true,
               changeYear: true,
               yearRange: '1930:2025'
            });
    }

        $(document).ready(function() {
        $("#form").on("submit", function(event) {
            var correct = true;
            if (!sinEspaciosThis($("#txtUserName")) || !validarPasswordThis($("#txtPassword")) || !soloLetrasThis($("#txtNombre")) || !soloLetrasThis($("#txtApellidoPaterno")) || !soloLetrasThis($("#txtApellidoMaterno")) || !validarCorreo($("#txtEmail")) ||!soloNumerosThis($("#txtTelefono")) || !soloNumerosThis($("#txtCelular")) ||  !validarCURP($("#txtCURP")) || !validarRol($("#ddlRol")) || !validarSexo() || !validarFecha($("#txtFechaNacimiento"))){
                correct = false;
            }
            if (!correct) {
                event.preventDefault();
            }
        });
      });
    function soloLetrasThis(input) {
        var div = $(input).closest("div");
        var span = div.children("span").first();
        var regex = /^[a-zA-Z\s]*$/;
        if($(input).val() === ""){
          $(input).css("border", "2px solid orange");
          span.text("Recuerda no dejar el espacio vacio").addClass("text-warning")
          return false
        }
        if (regex.test($(input).val())){
            $(input).css("border", "2px solid green");
            span.text("").removeClass("text-danger");
            return true;
        }else {
            $(input).css("border", "2px solid red");
            return false;
          }
        }
    function soloLetrasEvent(input,event) { 
        var div = $(input).closest("div");
        var span = div.children("span").first();
        var regex = /^[a-zA-Z\s]*$/;
          if (regex.test(event.key)) {
              $(input).css("border", "2px solid green");
              span.text("").removeClass("text-danger")
              return true;
          } else {
              $(input).css("border", "2px solid red");
              span.text("No se aceptan numeros").addClass("text-danger")
              return false;
          }
        }
    function sinEspaciosThis(input) {
        var div = $(input).closest("div");
        var span = div.children("span").first();
        var regex = /^[a-zA-Z0-9]*$/; 
            if($(input).val() === ""){
          $(input).css("border", "2px solid orange");
          span.text("Recuerda no dejar el espacio vacio").addClass("text-warning")
          return false
        }
        if (regex.test($(input).val())){
            $(input).css("border", "2px solid green");
            span.text("").removeClass("text-danger");
            return true;
        }else {
            $(input).css("border", "2px solid red");
            return false;
          }
        }
    function sinEspaciosEvent(input, event) {
        var div = $(input).closest("div");
        var span = div.children("span").first();
        var regex = /^[a-zA-Z0-9]*$/;
           if (regex.test(event.key)) {
                $(input).css("border", "2px solid green");
                 span.text("").removeClass("text-danger")
                 return true;
           } else {
                 $(input).css("border", "2px solid red");
                 span.text("No se aceptan espacios").addClass("text-danger")
                 return false;
           }
        }
    function soloNumerosThis(input) {
        var div = $(input).closest("div");
        var span = div.children("span").first();
        var regex = /^[0-9]*$/; 
       if($(input).val() === ""){
          $(input).css("border", "2px solid orange");
          span.text("Recuerda no dejar el espacio vacio").addClass("text-warning")
          return false
        }
            if (regex.test($(input).val())){
                $(input).css("border", "2px solid green");
                span.text("").removeClass("text-danger");
                return true;
            }else {
                $(input).css("border", "2px solid red");
                return false;
          }
        }
    function soloNumerosEvent(input, event) {
        var div = $(input).closest("div");
        var span = div.children("span").first();
        var regex = /^[0-9]*$/; // acepta solo numeros
        
        if (regex.test(event.key)) {
            $(input).css("border", "2px solid green");
            span.text("").removeClass("text-danger")
            return true;
            } else {
            $(input).css("border", "2px solid red");
            span.text("Solo se permiten numeros").addClass("text-danger")

            return false;
            }
        }
    function validarPasswordThis(input){
        var div = $(input).closest("div");
        var span = div.children("span").first();
        var regex = /^[a-zA-Z0-9._%-]*$/;
        
        if($(input).val() === ""){
          $(input).css("border", "2px solid orange");
          span.text("Recuerda no dejar el espacio vacio").addClass("text-warning")
          return false
            }
            if (regex.test($(input).val())){
                $(input).css("border", "2px solid green");
                span.text("").removeClass("text-danger");
                return true;
            }else {
                $(input).css("border", "2px solid red");
                return false;
          }
        }       
    function validarPasswordEvent(input, event){
        var div = $(input).closest("div");
        var span = div.children("span").first();
        var regex = /^[a-zA-Z0-9._%-]*$/;

        if (regex.test(event.key)) {
            $(input).css("border", "2px solid green");
            span.text("").removeClass("text-danger")
            return true;
        } else {
            $(input).css("border", "2px solid red");
             span.text("Ingresa una contraseña minimo con una Minus, una Mayus, un número y un caracter especial").addClass("text-danger")
            return false;
        }
    }  
    function validarCURP(input){
        var div = $(input).closest("div");
        var span = div.children("span").first();
        var regex = /^([A-Z][AEIOUX][A-Z]{2}\d{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\d|3[01])[HM](?:AS|B[CS]|C[CLMSH]|D[FG]|G[TR]|HG|JC|M[CNS]|N[ETL]|OC|PL|Q[TR]|S[PLR]|T[CSL]|VZ|YN|ZS)[B-DF-HJ-NP-TV-Z]{3}[A-Z\d])(\d)$/
       if(regex.test($(input).val())){
           $(input).css("border", "2px solid green");
           span.text("").removeClass("text-danger")
           return true
       }else{
           $(input).css("border", "2px solid red");
           span.text("Ingresa una CURP válida y escribe en Mayuscula").addClass("text-danger")
            return false;
       }
    }
    function validarCorreo(input){
        var div = $(input).closest("div");
        var span = div.children("span").first();
        var regex = /^\b[A-Z0-9._%-]+@@[A-Z.-]+\.[A-Z]{2,4}\b$/i
       if(regex.test($(input).val())){
           $(input).css("border", "2px solid green");
           span.text("").removeClass("text-danger")
           return true
       }else{
           $(input).css("border", "2px solid red");
           span.text(" Ejemplo de correo válido: Example_1234.%_@@gmail.com").addClass("text-danger")
            return false;
       }
    }
    function validarRol(select) {
        var div = $(select).closest("div");
        var span = div.children("span").first();

         if ($(select).val() === "") {
            $(select).css("border", "2px solid red");
            span.text("Seleccione un Rol").addClass("text-danger");
            return false;
          }else {
            $(select).css("border", "2px solid green");
            span.text("").removeClass("text-danger");
            return true;
        }
    }
    function validarSexo() {
        var radios = $("input[name='Sexo']");
        var div = radios.closest("div.col-md-6");
        var span = div.children("span").first();

        if (radios.filter(":checked").length === 0) {
            span.text("Debe seleccionar una opción").addClass("text-danger");
            radios.each(function () {
                $(this).css("outline", "2px solid red");
            });
            return false;
        } else {
            span.text("").removeClass("text-danger");
            radios.each(function () {
                $(this).css("outline", "none");
            });
            return true;
        }
    }
    function validarFecha(input){
        var div = $(input).closest("div");
        var span = div.children("span").first();
        var regex = /^(0[1-9]|[12][0-9]|3[01])[/](0[1-9]|1[0-2])[/](19|20)\d{2}$/;

        if(regex.test($(input).val())){
            $(input).css("border", "2px solid green");
            span.text("").removeClass("text-danger");
            return true;
        } else {
            $(input).css("border", "2px solid red");
            span.text("Ingresa una fecha válida (dd/mm/yyyy)").addClass("text-danger");
            return false;
        }
    }

</script>



