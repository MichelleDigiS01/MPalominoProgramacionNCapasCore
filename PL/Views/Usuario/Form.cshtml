@model ML.Usuario
@{
    ViewData["Title"] = "Form";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">

    @if (Model.IdUsuario > 0)
    {
        <h1>Formulario Actualizar</h1>
    }
    else
    {
        <h1>Formulario Agregar</h1>
    }


        @using (Html.BeginForm("Form", "Usuario", FormMethod.Post, new { @enctype = "multipart/form-data", onsubmit = "return validateForm()" }))
    {

        
            <div class="row">
                @*Parte del Datos Usuario*@
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header text-center">
                            Datos Usuario
                        </div>
                        <div class="card-body">

                            @Html.HiddenFor(model => model.IdUsuario)

                            <div class="row">
                                <div class="col-md-6 mt-2">

                                    @Html.LabelFor(model => model.UserName)
                                    @Html.TextBoxFor(model => model.UserName, new { @class = "form-control", onblur = "return sinEspacios(this)", onkeypress = "return sinEspacios(this, event)", @id = "txtUserName" })
                                    <span></span>
                                </div>
                                <div class="col-md-6 mt-2">
                                    @Html.LabelFor(model => model.Password)
                                    @Html.TextBoxFor(model => model.Password, new { @class = "form-control", onblur = "return validarPassword(this)", onkeypress = "return validarPassword(this, event)", @id = "txtPassword" })
                                    <span></span>
                                </div>

                            </div>

                            <div class="row">
                                <div class="col-md-4 mt-2">
                                    @Html.LabelFor(model => model.Nombre, new { @id = "lblNombre" })
                                    @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control", onblur = "return soloLetras(this)", onkeypress = "return soloLetras(this, event)", @id = "txtNombre" })
                                    <span></span>

                                </div>
                                <div class="col-md-4 mt-2">

                                    @Html.LabelFor(model => model.ApellidoPaterno, "Apellido Paterno")
                                    @Html.TextBoxFor(model => model.ApellidoPaterno, new { @class = "form-control", onblur = "return soloLetras(this)", onkeypress = "return soloLetras(this, event)", @id = "txtApellidoPaterno" })
                                    <span></span>
                                </div>

                                <div class="col-md-4 mt-2">
                                    @Html.LabelFor(model => model.ApellidoMaterno, "Apellido Materno")
                                    @Html.TextBoxFor(model => model.ApellidoMaterno, new { @class = "form-control", onblur = "return soloLetras(this)", onkeypress = "return soloLetras(this, event)", @id = "txtApellidoMaterno" })
                                    <span></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mt-2">

                                    @Html.LabelFor(model => model.Email)
                                    @Html.TextBoxFor(model => model.Email, new { @class = "form-control", onblur = "return validarCorreo(this)", @id = "txtEmail" })
                                    <span></span>
                                </div>
                                <div class="col-md-6 mt-2">
                                    <label class="form-label d-block">Sexo</label>
                                    <div class="form-check form-check-inline">
                                        @Html.RadioButtonFor(model => model.Sexo, "M ", new { @class = "form-check-input", id = "sexoM" })
                                        <label class="form-check-label" for="sexoM">Masculino</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        @Html.RadioButtonFor(model => model.Sexo, "F ", new { @class = "form-check-input", id = "sexoF" })
                                        <label class="form-check-label" for="sexoF">Femenino</label>
                                    </div>
                                    <span></span>
                                </div>
                            </div>


                            <div class="row">

                                <div class="col-md-6 mt-2">
                                    @Html.LabelFor(model => model.Telefono)
                                    @Html.TextBoxFor(model => model.Telefono, new { @class = "form-control", onblur = "return soloNumeros(this)", onkeypress = "return soloNumeros(this, event)", @id = "txtTelefono" })
                                    <span></span>
                                </div>

                                <div class="col-md-6 mt-2">

                                    @Html.LabelFor(model => model.Celular)
                                    @Html.TextBoxFor(model => model.Celular, new { @class = "form-control", onblur = "return soloNumeros(this)", onkeypress = "return soloNumeros(this, event)", @id = "txtCelular" })
                                    <span></span>
                                </div>


                            </div>
                            <div class="row">

                                <div class="col-md-4 mt-2">


                                    @Html.LabelFor(model => model.FechaNacimiento, "Fecha de Nacimiento")

                                    @Html.TextBox("FechaNacimiento", Model.FechaNacimiento.ToString("yyyy-MM-dd"), new { @class = "form-control", type = "date" })

                                </div>
                                <div class="col-md-4 mt-2">

                                    @Html.LabelFor(model => model.Curp)
                                    @Html.TextBoxFor(model => model.Curp, new { @class = "form-control", onblur = "return validarCURP(this, event)", @id = "txtCURP" })
                                    <span></span>
                                </div>
                                <div class="col-md-4 mt-2">
                                    @Html.LabelFor(model => model.Rol.IdRol, "Rol")
                                @Html.DropDownListFor(model => model.Rol.IdRol, new SelectList(Model.Rol.Rols, "IdRol", "Nombre"), "Seleccione un Rol", new { @class = "form-control", @id = "ddlRol", onchange = " return validarRol(this)" })
                                <span></span>
                                </div>
                            </div>


                        </div>

                    </div>
                </div>

                <div class="row">

                    <div class="row">
                        <div class="col-md-6 mt-3">

                            <button type="submit" value="GuardarUsuario" name="Action" class="btn btn-success pl">Guardar</button>

                            @Html.ActionLink("Regresar", "GetAll", "Usuario", new { IdUsuario = 0 }, new { @class = "btn btn-danger" })
                        </div>
                    </div>
                </div>
            </div>
       
    }
</div>



<script src="~/lib/jquery/dist/jquery.js"></script>
<script>


    function validateForm() {
    let isValid = true;

    // Valida cada campo
    const campos = [
        { id: "txtUserName", mensaje: "Nombre de usuario obligatorio", validador: sinEspacios },
        { id: "txtPassword", mensaje: "Contraseña obligatoria", validador: validarPassword },
        { id: "txtNombre", mensaje: "Nombre obligatorio", validador: soloLetras },
        { id: "txtApellidoPaterno", mensaje: "Apellido paterno obligatorio", validador: soloLetras },
        { id: "txtApellidoMaterno", mensaje: "Apellido materno obligatorio", validador: soloLetras },
        { id: "txtTelefono", mensaje: "Teléfono obligatorio", validador: soloNumeros },
        { id: "txtCelular", mensaje: "Celular obligatorio", validador: soloNumeros },
        { id: "txtEmail", mensaje: "Email obligatorio", validador: validarCorreo },
        { id: "txtCURP", mensaje: "CURP obligatorio", validador: validarCURP },
        { id: "ddlRol", mensaje: "Seleccione un Rol", validador: validarRol },


        ];

    campos.forEach(campo => {
        let input = document.getElementById(campo.id);
        let div = $(input).closest("div");
        let span = div.children("span");

        if (input.value.trim() == "") {
            $(input).css("border", "2px solid red");
            span.text(campo.mensaje).addClass("text-danger");
            isValid = false;
        } else {
            if (campo.validador && !campo.validador(input)) {
                isValid = false; 
            } else {
                $(input).css("border", "2px solid green");
                span.text("").removeClass("text-danger");
            }
        }
    });

    return isValid;
    }

    function soloLetras(input) {
        var div = $(input).closest("div");
        var span = div.children("span")
        
        if(event.type == "blur"){
            if($(input).val().trim() == ""){
              $(input).css("border", "2px solid orange");
              span.text("Recuerda no dejar el espacio vacio").addClass("text-warning")
              return false
            }
              var regex = /^[a-zA-Z\s]*$/;
              if (regex.test($(input).val())){
                $(input).css("border", "2px solid green");
                span.text("").removeClass("text-danger")
                return true;
              } else {
                $(input).css("border", "2px solid red");
                span.text("No se aceptan numeros").addClass("text-danger")
                return false;
              }
        }else{
            var regex = /^[a-zA-Z\s]*$/;
            if (regex.test(event.key)) {
                $(input).css("border", "2px solid green");
                span.text("").removeClass("text-danger")
                return true;
            } else {
                $(input).css("border", "2px solid red");
                span.text("No se aceptan numeros").addClass("text-danger")
                return false;
            }
        }
    }
    function sinEspacios(input) {
        var div = $(input).closest("div");
        var span = div.children("span")

        if(event.type == "blur"){
            if($(input).val().trim() == ""){
              $(input).css("border", "2px solid orange");
              span.text("Recuerda no dejar el espacio vacio").addClass("text-warning")
              return false
            }

            var regex = /^[a-zA-Z0-9]*$/; // acepta mayúsculas, minúsculas y numeros
            if (regex.test($(input).val())){
                 $(input).css("border", "2px solid green");
                  span.text("").removeClass("text-danger")
                  return true;
            } else {
                  $(input).css("border", "2px solid red");
                  span.text("No se aceptan espacios").addClass("text-danger")

                  return false;
            }
         
        }else{
        var regex = /^[a-zA-Z0-9]*$/; // acepta mayúsculas, minúsculas y numeros
            if (regex.test(event.key)) {
                 $(input).css("border", "2px solid green");
                  span.text("").removeClass("text-danger")
                  return true;
            } else {
                  $(input).css("border", "2px solid red");
                  span.text("No se aceptan esapacios").addClass("text-danger")

                  return false;
            }
        }
    }
    function soloNumeros(input) {

        var div = $(input).closest("div");
        var span = div.children("span")

        if(event.type == "keypress"){
          var regex = /^[0-9]*$/; // acepta solo numeros
                if (regex.test(event.key)) {
                 $(input).css("border", "2px solid green");
                  span.text("").removeClass("text-danger")
                  return true;
            } else {
                  $(input).css("border", "2px solid red");
                  span.text("Solo se permiten numeros").addClass("text-danger")

                  return false;
            }
        }else{
                if($(input).val().trim() == ""){
                  $(input).css("border", "2px solid orange");
                  span.text("Recuerda no dejar el espacio vacio").addClass("text-warning")
                  return false
                }
           var regex = /^[0-9]*$/; // acepta solo numeros
                    if (regex.test($(input).val())){
                     $(input).css("border", "2px solid green");
                      span.text("").removeClass("text-danger")
                      return true;
                } else {
                      $(input).css("border", "2px solid red");
                      span.text("Solo se permiten numeros").addClass("text-danger")

                      return false;
                }
        }
    }
    function validarPassword(input){
        var div = $(input).closest("div");
        var span = div.children("span")

        if(event.type == "blur"){

            if($(input).val().trim() == ""){
              $(input).css("border", "2px solid orange");
              span.text("Recuerda no dejar el espacio vacio").addClass("text-warning")
              return false
            }
            var regex = /^[a-zA-Z0-9]*$/;
            if (regex.test($(input).val())){
                $(input).css("border", "2px solid green");
                span.text("").removeClass("text-danger")
                return true;
            } else {
                $(input).css("border", "2px solid red");
                 span.text("No se permiten espacios").addClass("text-danger")
                return false;
            }
        }else{
            var regex = /^[a-zA-Z0-9]*$/;
            
            if (regex.test(event.key)) {
                $(input).css("border", "2px solid green");
                span.text("").removeClass("text-danger")
                return true;
            } else {
                $(input).css("border", "2px solid red");
                 span.text("No se permiten espacios").addClass("text-danger")
                return false;
            }
        }
        
    }
    function validarCURP(input){
        var div = $(input).closest("div");
        var span = div.children("span")

        var regex = /^([A-Z][AEIOUX][A-Z]{2}\d{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\d|3[01])[HM](?:AS|B[CS]|C[CLMSH]|D[FG]|G[TR]|HG|JC|M[CNS]|N[ETL]|OC|PL|Q[TR]|S[PLR]|T[CSL]|VZ|YN|ZS)[B-DF-HJ-NP-TV-Z]{3}[A-Z\d])(\d)$/
       
       if(regex.test($(input).val())){
           $(input).css("border", "2px solid green");
           span.text("").removeClass("text-danger")
           return true
       }else{

           $(input).css("border", "2px solid red");
           span.text("Ingresa una CURP valida y escribe en Mayuscula").addClass("text-danger")
           
            return false;
       }
    }
    function validarCorreo(input){
        var div = $(input).closest("div");
        var span = div.children("span")
        var regex = /^\b[A-Z0-9._%-]+@@[A-Z.-]+\.[A-Z]{2,4}\b$/i
       if(regex.test($(input).val())){
           $(input).css("border", "2px solid green");
           span.text("").removeClass("text-danger")
           return true
       }else{
           $(input).css("border", "2px solid red");
           span.text("Debe contener @@").addClass("text-danger")
            return false;
       }
    }
    
    function validarRol(select) {
        var div = $(select).closest("div");
        var span = div.children("span");

         if ($(select).val() == 0) {
            $(select).css("border", "2px solid red");
            span.text("Seleccione un Rol").addClass("text-danger");
            return false;
          }else {
            $(select).css("border", "2px solid green");
            span.text("").removeClass("text-danger");
            return true;
        }
    }

</script>



